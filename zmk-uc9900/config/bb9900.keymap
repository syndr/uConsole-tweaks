/*
 * uc9900 (uConsole Trackpad Keyboard) keymap for uConsole-tweaks, on ZMK v0.3.0.
 * Derived from the vendor keymap (Bill-lulu/uc9900 V2.0, MIT).
 *
 * Changes from the vendor keymap:
 *   - Select: tap = gamepad Select (K_SELECT), hold = scroll with the trackpad.
 *     Caps Lock (Fn+Tab) also puts the trackpad into scroll mode, as before.
 *   - Fn + / switches scroll mode on and off; Fn + ' flips the scroll direction
 *     (natural / inverted) and remembers it.
 *   - Hold Y or B and the D-pad moves the pointer; a tap still sends F21 / F23.
 *   - Start: tap = Play, hold = Super. Left Alt + Right Alt + Start = bootloader.
 *   - Tab: tap = Tab, hold = Super (what the keyd config did on the host).
 *   - Speaker: Volume Down; Shift+Speaker = Volume Up; Fn+Speaker = Mute.
 *   - Right Alt and Right Ctrl work under both Fn keys (they were unbound).
 *   - Fn+Start sends Pause (vendor bound a consumer code to the mouse-button behavior).
 *   - Right Fn + Esc toggles the output between USB and the selected Bluetooth
 *     profile; clearing bonds moved to both Fn keys + Esc so it can't be hit by accident.
 *   - Both Fn keys + R restarts the keyboard (was right Fn + left Fn).
 *
 * ZMK combos are deliberately not used: on this board they break the Enter key.
 *
 * Key positions (74 keys):
 *    0 Left   1 L-btn   2 Trackpad press   3 Y   4 X
 *    5 Up     6 Down    7 Right   8 R-btn   9 B  10 A
 *   11 Esc   12 Select  13 Start  14 Speaker  15 [  16 ]  17 /  18 -  19 =  20 backslash
 *   21 `     22-31 1..0  32 Backspace
 *   33 Tab   34-43 Q..P
 *   44 '     45-54 A..;  55 Enter
 *   56 LShift  57-65 Z../.  66 RShift
 *   67 Fn-L  68 LCtrl  69 LAlt  70 Space  71 RAlt  72 RCtrl  73 Fn-R
 */

#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE   0
#define SYM    1   // left Fn
#define UPPER  2   // right Fn
#define BOTH   3   // both Fn keys
#define SCROLL 4   // trackpad scrolls (keep CONFIG_UC9900_SCROLL_LAYER in step)
#define MOUSE  5   // D-pad moves the pointer

/* Scroll speed: raw sensor units are multiplied by SCROLL_MUL/SCROLL_DIV before
 * the host's resolution multiplier (16 units per notch). 3/8 gives one notch
 * per ~43 sensor units, the same as the zmk-cursor-scroll daemon's 64 pointer
 * pixels. */
#define SCROLL_MUL 3
#define SCROLL_DIV 8

&trackpad_listener {
    scroller {
        layers = <SCROLL>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,
                           <&zip_xy_to_scroll_mapper>,
                           <&scroll_dir>,
                           <&zip_scroll_scaler SCROLL_MUL SCROLL_DIV>;
    };
};

/ {
    behaviors {
        // Select: hold = scroll layer from the moment it is pressed, release
        // within the term = a Select tap. A long hold sends no key at all.
        selscroll: select_scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&mo>, <&kp>;
        };

        // Y / B: hold with a D-pad key = pointer movement; anything else = tap.
        dpadmouse: dpad_mouse {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <0 5 6 7>;
            bindings = <&mo>, <&kp>;
        };

        // Tab: tap = Tab, hold = Super. "balanced" also counts a hold when another
        // key is pressed and released while Tab is down, like keyd's overloadt2.
        tabgui: tab_super {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Start: tap = Play, hold = Super.
        startgui: start_super {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Start with both Alt keys held enters the bootloader. Two nested
        // mod-morphs stand in for a combo. Alt is kept so Alt+Start chords
        // still carry Alt.
        start_key: start_key {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&startgui LGUI C_PLAY>, <&start_ralt>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };
        start_ralt: start_ralt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&startgui LGUI C_PLAY>, <&bootloader>;
            mods = <(MOD_RALT)>;
            keep-mods = <(MOD_RALT)>;
        };

        // Speaker: Volume Down, Shift+Speaker = Volume Up.
        // A plain mod-morph is not enough: it masks Shift only in the keyboard
        // report, and a consumer key never resends that report, so the host
        // kept seeing Shift+VolumeUp (verified by capture). The morphs pick the
        // Shift that is held and run a macro that releases it, taps Volume Up
        // and presses it again, which forces the keyboard report out.
        spk_vol: speaker_volume {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&spk_vol_r>, <&vol_up_lsft>;
            mods = <(MOD_LSFT)>;
        };
        spk_vol_r: speaker_volume_rshift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp C_VOL_DN>, <&vol_up_rsft>;
            mods = <(MOD_RSFT)>;
        };
        vol_up_lsft: vol_up_lsft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_release &kp LSHFT>, <&macro_tap &kp C_VOL_UP>, <&macro_press &kp LSHFT>;
        };
        vol_up_rsft: vol_up_rsft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&macro_release &kp RSHFT>, <&macro_tap &kp C_VOL_UP>, <&macro_press &kp RSHFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            &kp LEFT                  &mkp LCLK      &mkp LCLK     &dpadmouse MOUSE F21   &kp F22
&kp UP   &kp DOWN  &kp RIGHT                        &mkp RCLK                 &dpadmouse MOUSE F23   &kp F24
&kp ESC    &selscroll SCROLL K_SELECT  &start_key   &spk_vol    &kp LBKT   &kp RBKT   &kp FSLH   &kp MINUS  &kp EQUAL  &kp BACKSLASH
&kp GRAVE  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8     &kp N9   &kp N0  &kp BSPC
&tabgui LGUI TAB   &kp Q   &kp W   &kp E   &kp R   &kp T   &kp Y   &kp U   &kp I      &kp O    &kp P
&kp SQT    &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K      &kp L    &kp SEMICOLON  &kp ENTER
&kp LSHFT  &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA  &kp DOT  &kp RSHFT
  &mo SYM  &kp LCTRL         &kp LALT          &kp SPACE         &kp RALT       &kp RCTRL   &mo UPPER
            >;
        };

        // Left Fn
        sym_layer {
            bindings = <
            &kp LEFT                  &mkp LCLK      &mkp RCLK     &kp Y       &kp X
&kp K_VOL_UP  &kp K_VOL_DN  &kp RIGHT                &mkp RCLK                 &kp B       &kp A
&kp C_AL_SCREENSAVER  &kp C_AC_PRINT  &kp C_PAUSE  &kp C_MUTE  &none  &none  &tog SCROLL  &kp F11  &kp F12  &bootloader
&none      &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8     &kp F9   &kp F10  &kp DEL
&kp CAPSLOCK  &kp Q  &kp W   &kp E    &kp R    &kp T    &kp Y    &kp PAGE_UP  &kp INSERT  &kp O  &kp P
&scroll_dir_tog  &kp A  &kp S  &kp D  &kp F    &kp G    &kp HOME &kp END  &kp PAGE_DOWN  &kp L  &none  &none
&none      &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp C_BRI_DN  &kp C_BRI_UP  &kp RSHFT
  &none    &kp LCTRL         &kp LGUI          &bl BL_TOG        &kp RALT       &kp RCTRL   &mo BOTH
            >;
        };

        // Right Fn
        upper_layer {
            bindings = <
            &kp LEFT                  &mkp LCLK      &mkp RCLK     &kp Y       &kp X
&kp UP   &kp DOWN  &kp RIGHT                        &mkp RCLK                 &kp B       &kp A
&out OUT_TOG  &kp C_AC_PRINT  &kp C_PAUSE  &kp C_MUTE  &none  &none  &tog SCROLL  &kp F11  &kp F12  &bootloader
&none      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp DEL
&kp CAPSLOCK  &kp Q  &kp W   &kp E    &kp R    &kp T    &kp Y    &kp PAGE_UP  &kp INSERT  &kp O  &kp P
&scroll_dir_tog  &kp A  &kp S  &kp D  &kp F    &kp G    &kp HOME &kp END  &kp PAGE_DOWN  &kp L  &none  &none
&none      &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp C_BRI_DN  &kp C_BRI_UP  &kp RSHFT
  &mo BOTH &kp LCTRL         &kp LALT          &bl BL_TOG        &kp RALT       &kp RCTRL   &none
            >;
        };

        // Both Fn keys: the dangerous things. Everything else falls through.
        both_layer {
            bindings = <
            &trans                    &trans         &trans        &trans      &trans
&trans   &trans    &trans                           &trans                    &trans      &trans
&bt BT_CLR  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bootloader
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans   &trans
&trans     &trans   &trans   &trans   &sys_reset  &trans  &trans  &trans  &trans    &trans   &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans   &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans
  &trans   &trans            &trans            &trans            &trans         &trans      &trans
            >;
        };

        // Trackpad scrolls (hold Select, Caps Lock on, or Fn+/). Keys are unchanged.
        scroll_layer {
            bindings = <
            &trans                    &trans         &trans        &trans      &trans
&trans   &trans    &trans                           &trans                    &trans      &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans   &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans   &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans
  &trans   &trans            &trans            &trans            &trans         &trans      &trans
            >;
        };

        // Y or B held: the D-pad moves the pointer.
        mouse_layer {
            bindings = <
            &mmv MOVE_LEFT            &trans         &trans        &trans      &trans
&mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT          &trans                    &trans      &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans   &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans   &trans
&trans     &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans     &trans   &trans
  &trans   &trans            &trans            &trans            &trans         &trans      &trans
            >;
        };
    };
};
