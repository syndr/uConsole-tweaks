// Waybar custom module for the voltage-based uConsole battery gauge.
//
// 1. Add "custom/uconsole-battery" to a modules-* array in your active waybar
//    config (e.g. replace the built-in "battery" entry).
// 2. Merge the block below into that config's top level.
// 3. Style it in style.css via #custom-uconsole-battery{,.charging,.warning,
//    .critical,.full} — the same class names the built-in battery module uses.
// 4. Optional: the CPU profile menu at the end of the block (see the README).
//
// The script emits JSON, so `return-type` MUST be "json". It is stateless and
// cheap; waybar re-runs it every `interval` seconds.
"custom/uconsole-battery": {
	"exec": "/usr/local/bin/uconsole-battery",
	"return-type": "json",
	"interval": 30,
	"tooltip": true,
	"format": "{icon} {}",
	"format-icons": {
		"charging": "",
		"full": "",
		"discharging": "",
		"warning": "",
		"critical": ""
	},
	// --- CPU profile menu (needs uconsole-sleep >= 1.8) ----------------------
	// Uncomment the keys below: left click then opens a menu to pick
	// Automatic / Performance / Balanced / Power save for this boot.
	// "signal" makes a selection show at once instead of at the next interval;
	// it must be a number no other module here uses (WAYBAR_SIGNAL in
	// uconsole-battery.conf changes it). `uconsole-battery
	// --waybar-menu-snippet` prints the same keys.
	// "signal": 13,
	// "menu": "on-click",
	// "menu-file": "/usr/share/uconsole-tweaks/waybar-cpu-profile-menu.ui",
	// "menu-actions": {
	//     "auto":        "/usr/local/bin/uconsole-battery --set-cpu-profile auto",
	//     "performance": "/usr/local/bin/uconsole-battery --set-cpu-profile performance",
	//     "schedutil":   "/usr/local/bin/uconsole-battery --set-cpu-profile schedutil",
	//     "powersave":   "/usr/local/bin/uconsole-battery --set-cpu-profile powersave"
	// }
}
