#!/usr/bin/env python3
"""Battery gauge for the uConsole's AXP223 PMIC with a stuck-gauge fallback.

The AXP223 has a real coulomb-counting fuel gauge, exported by the kernel as
/sys/class/power_supply/axp20x-battery/capacity, and when it works it is the
best number available. But on these boards it periodically gets stuck — most
often pinned at 100% while the pack is clearly discharging, sometimes frozen at
some other value. upower, waybar's built-in `battery` module, hyprlock and
swaync all trust it blindly, so a stuck gauge means no usable indicator and no
low-battery warning before the hard cutoff around 3.2 V.

The chip's voltage and current ADCs *are* reliable, so this script keeps an
independent voltage-based state-of-charge estimate running alongside:

  OCV  = V_terminal + I_discharge * R_internal   (add IR drop back under load)
       = V_terminal - I_charge    * R_internal   (remove IR rise under charge)
  SoC  = interpolate(OCV) against a Li-ion open-circuit-voltage curve

and uses it to judge the kernel gauge:

  * healthy  -> display the kernel `capacity`
  * stuck    -> display the voltage estimate until the gauge moves again

"Stuck" is decided from (a) the classic 100%-while-discharging signature,
(b) a gross disagreement with the voltage estimate, or (c) the reading not
changing while a meaningful amount of charge has flowed in or out. Once
flagged, the gauge is trusted again only after it moves to a plausible value.

While the gauge is stuck the fallback is not the raw voltage estimate but a
coulomb count anchored at the last trusted gauge value: last good percent
minus charge flowed since, over the pack capacity. That makes the switch-over
seamless and keeps the fallback accurate for hours. The voltage estimate bounds
it (re-anchor if they drift far apart) and takes over when there is no anchor
(stuck since boot, or the count was lost across a suspend).

Everything the healthy gauge teaches us is persisted in
$XDG_STATE_HOME/uconsole-battery/ and used from then on:
  * pack capacity   - integrated current / gauge drop over a discharge session
  * curve offsets   - gauge percent minus voltage estimate, per 5-point bin,
                      so the voltage estimate tracks this pack's real curve
  * internal R      - voltage sag / current step between consecutive samples,
                      replacing the hand-measured R_INTERNAL_OHMS

The tooltip also reports how long the pack has been discharging (or charging),
an estimated time remaining / time to full from a smoothed average of the
measured current, the pack capacity in use and the calibration state.

Small per-run state (previous reading, integrated charge flow, stuck flag,
averages) is kept in $XDG_RUNTIME_DIR/uconsole-battery.state, since waybar
re-runs the script on an interval with no shared process.

Output modes:
  (default)       waybar custom-module JSON: {"text","alt","percentage","tooltip","class"}
  --percent       just the integer percentage (for scripts)
  --text          "<pct>% (<state>[, ~<time> left])"
  --force-voltage always display the voltage estimate (old behaviour / debugging)
  --calibration   print the learned capacity / curve offsets / resistance as JSON
  --debug         dump config overrides, state and the stuck decision to stderr

CPU governor (optional, needs uConsole-sleep >= 1.8; see the tweak README):
  --cpu-profile             print the governor and why it is set
  --set-cpu-profile WORD    select 'auto' or a governor for this boot
  --waybar-menu-snippet     print the waybar keys that add the profile menu
                            (--if-available: for config generators)

Package defaults live in the constants below. Device-specific values (pack
capacity, measured internal resistance, thresholds, bar text format) go in a
config file — /etc/uconsole-battery.conf and/or ~/.config/uconsole-battery.conf,
KEY=VALUE lines, later file wins. See the tweak README and
uconsole-battery.conf.example.
"""

import argparse
import glob
import json
import math
import os
import shutil
import signal
import subprocess
import sys
import time

# --- tunables (package defaults; override via config file) -------------------

# Preferred power-supply name; falls back to the first Battery-type supply.
BATTERY_NAME = "axp20x-battery"

# Pack internal resistance (ohms), used to reconstruct open-circuit voltage from
# the loaded terminal voltage. The single biggest lever on the estimate's
# accuracy: too low and it reads pessimistic under load, too high optimistic.
# Default 0.08 is the delta-V/delta-I value measured on a uConsole 2P Li-ion
# pack (three runs, 0.074-0.083). Re-measure with uconsole-battery-calibrate.
# A learned value (LEARN_RESISTANCE) takes precedence once it has enough
# samples.
R_INTERNAL_OHMS = 0.08

# Clamp on the IR correction so a transient current spike can't throw the OCV
# wildly off the curve.
MAX_IR_CORRECTION_V = 0.35

# Exponential smoothing of the voltage estimate across invocations
# (0 = frozen, 1 = no smoothing). Damps current-spike jitter.
EMA_ALPHA = 0.5

# Per-cell Li-ion open-circuit-voltage -> state-of-charge curve. Ordered high to
# low; linearly interpolated between points, clamped at the ends.
OCV_CURVE = [
    (4.20, 100), (4.15, 95), (4.11, 90), (4.08, 85), (4.02, 80),
    (3.98, 75), (3.95, 70), (3.91, 65), (3.87, 60), (3.85, 55),
    (3.84, 50), (3.82, 45), (3.80, 40), (3.79, 35), (3.77, 30),
    (3.75, 25), (3.73, 20), (3.71, 15), (3.69, 10), (3.61, 5),
    (3.50, 3), (3.27, 0),
]

# waybar `states` thresholds -> CSS class (mirrors the built-in battery module).
WARNING_PCT = 30
CRITICAL_PCT = 15

# Pack capacity in mAh. None = read charge_full_design from sysfs (the stock
# device-tree value, 6700 mAh for the stock 2x 18650 pack). Set this in the
# config file if you have fitted different cells. A learned value (see
# LEARN_CAPACITY) takes precedence over both once available.
PACK_CAPACITY_MAH = None
PACK_CAPACITY_FALLBACK_MAH = 6700.0

# Stuck-gauge rules. The gauge is flagged stuck when ANY of these trips:
#  - it reads 100 while Discharging and the voltage estimate is below this:
STUCK_FULL_MAX_EST_PCT = 85.0
#  - it disagrees with the voltage estimate by more than this many points:
STUCK_DISAGREE_PCT = 25.0
#  - it has not changed while at least this much of the pack (percent of
#    the pack capacity) has flowed in or out since it last changed:
STUCK_NO_MOVE_PCT = 4.0
# A flagged gauge is trusted again only when it moves to a new value, in the
# direction the status implies, within this many points of the estimate:
RECOVER_AGREE_PCT = 12.0
# Cap on the time step used when integrating current across runs, so a suspend
# or a stopped waybar doesn't book hours of phantom charge flow. A gap longer
# than this also resets the runtime average and invalidates capacity learning.
MAX_SAMPLE_GAP_S = 300.0

# Runtime estimate: time constant (s) of the moving average of |current| that
# the remaining-time figure divides by. Longer = steadier but slower to follow
# a change in load.
RUNTIME_TAU_S = 300.0
# While the gauge is healthy the estimate uses the gauge's own scale: mAh of
# measured flow per point the gauge moved, averaged over recent moves (EMA
# weight of the newest move). This is immune to a wrong PACK_CAPACITY_MAH and
# to whatever capacity the AXP223 scales its percent against. The capacity
# figure is only used before the first move and while the gauge is stuck.
RATE_ALPHA = 0.4
# Don't show a remaining-time figure until this many seconds of samples have
# been averaged since the charge/discharge status last changed.
RUNTIME_MIN_SPAN_S = 60.0
# Hide "time to full" above this percentage: the constant-voltage tail of the
# charge makes the simple current-based figure meaningless up there.
TIME_TO_FULL_MAX_PCT = 90.0

# Learn the effective pack capacity from discharge sessions (gauge drop vs
# integrated current) and persist it in $XDG_STATE_HOME/uconsole-battery/.
LEARN_CAPACITY = True
# Minimum gauge drop (points) within one uninterrupted, healthy-gauge
# discharge session before a learned value is written.
LEARN_MIN_DROP_PCT = 30.0

# Coulomb-count fallback: while the gauge is stuck, display the last trusted
# gauge value minus charge flowed since. If that drifts further than this many
# points from the voltage estimate, re-anchor on the estimate.
CC_REANCHOR_PCT = 15.0

# Learn per-level offsets between the healthy gauge and the voltage estimate
# (5-point bins of the estimate) and apply them to the estimate thereafter.
LEARN_CURVE = True
# Samples a bin needs before its offset is trusted (one sample per run).
CAL_MIN_SAMPLES = 20
# Clamp on the applied offset, so a misbehaving gauge can't drag the yardstick.
CAL_MAX_OFFSET_PCT = 15.0

# Learn the pack's internal resistance from consecutive discharging samples
# whose current differs by at least R_LEARN_MIN_DI amps:  R = -dV / d|I|.
LEARN_RESISTANCE = True
R_LEARN_MIN_DI = 0.3
R_LEARN_MAX_DT_S = 90.0
# Load steps needed before the learned R replaces R_INTERNAL_OHMS.
R_LEARN_MIN_SAMPLES = 10

# Bar text. Python str.format fields: {pct} {volt} {amps} {watts} {remaining}
# {status}. E.g. "{pct}% {volt:.2f}V" to show the voltage next to the percent.
TEXT_FORMAT = "{pct}%"

# Always display the voltage estimate (ignore the gauge). Mostly for debugging.
FORCE_VOLTAGE = False

# After --set-cpu-profile, waybar is sent SIGRTMIN+<this> so a module with
# `"signal": <this>` re-runs the script at once instead of at its next
# interval. --waybar-menu-snippet prints the matching key. 0 disables both.
WAYBAR_SIGNAL = 13

# Keys the config file may override, with the type to coerce the value to.
CONFIG_TYPES = {
    "BATTERY_NAME": str,
    "R_INTERNAL_OHMS": float,
    "MAX_IR_CORRECTION_V": float,
    "EMA_ALPHA": float,
    "WARNING_PCT": int,
    "CRITICAL_PCT": int,
    "PACK_CAPACITY_MAH": float,
    "STUCK_FULL_MAX_EST_PCT": float,
    "STUCK_DISAGREE_PCT": float,
    "STUCK_NO_MOVE_PCT": float,
    "RECOVER_AGREE_PCT": float,
    "MAX_SAMPLE_GAP_S": float,
    "RUNTIME_TAU_S": float,
    "RATE_ALPHA": float,
    "RUNTIME_MIN_SPAN_S": float,
    "TIME_TO_FULL_MAX_PCT": float,
    "LEARN_CAPACITY": bool,
    "LEARN_MIN_DROP_PCT": float,
    "CC_REANCHOR_PCT": float,
    "LEARN_CURVE": bool,
    "CAL_MIN_SAMPLES": int,
    "CAL_MAX_OFFSET_PCT": float,
    "LEARN_RESISTANCE": bool,
    "R_LEARN_MIN_DI": float,
    "R_LEARN_MAX_DT_S": float,
    "R_LEARN_MIN_SAMPLES": int,
    "TEXT_FORMAT": str,
    "FORCE_VOLTAGE": bool,
    "WAYBAR_SIGNAL": int,
}

# Plausibility bounds for a learned internal resistance (ohms).
R_LEARN_MIN_OHMS, R_LEARN_MAX_OHMS = 0.02, 0.40
# Running-mean memory for the calibration EMAs (samples).
CAL_EMA_N = 200
R_EMA_N = 100
# Curve bin width (points of estimate) and how far outside the learned range
# an edge offset is tapered to zero.
CAL_BIN = 5
CAL_TAPER_PCT = 10.0

# -----------------------------------------------------------------------------


def debug_log(enabled, msg):
    if enabled:
        print(f"[uconsole-battery] {msg}", file=sys.stderr)


def is_num(x):
    return isinstance(x, (int, float)) and not isinstance(x, bool)


def config_paths():
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return ["/etc/uconsole-battery.conf", os.path.join(xdg, "uconsole-battery.conf")]


def coerce(value, typ):
    if typ is bool:
        v = value.strip().lower()
        if v in ("1", "true", "yes", "on"):
            return True
        if v in ("0", "false", "no", "off"):
            return False
        raise ValueError(f"not a boolean: {value!r}")
    if typ is int:
        return int(float(value))
    return typ(value)


def load_config(debug=False):
    """Apply KEY=VALUE overrides from the config files to the module globals."""
    g = globals()
    for path in config_paths():
        try:
            with open(path) as fh:
                lines = fh.readlines()
        except OSError:
            continue
        for lineno, line in enumerate(lines, 1):
            s = line.strip()
            if not s or s.startswith("#"):
                continue
            if "=" not in s:
                debug_log(debug, f"{path}:{lineno}: ignoring malformed line {s!r}")
                continue
            key, _, value = s.partition("=")
            key = key.strip()
            value = value.strip()
            if CONFIG_TYPES.get(key) is not str:
                value = value.split("#", 1)[0].strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            if key not in CONFIG_TYPES:
                debug_log(debug, f"{path}:{lineno}: unknown key {key!r} ignored")
                continue
            try:
                g[key] = coerce(value, CONFIG_TYPES[key])
            except ValueError as exc:
                debug_log(debug, f"{path}:{lineno}: bad value for {key}: {exc}")
                continue
            debug_log(debug, f"{path}: {key} = {g[key]!r}")


def sysfs_base():
    return os.environ.get("UCONSOLE_BATTERY_SYSFS") or "/sys/class/power_supply"


def find_battery():
    """Return the sysfs path of the battery supply, or None."""
    base = sysfs_base()
    preferred = os.path.join(base, BATTERY_NAME)
    if os.path.isdir(preferred):
        return preferred
    for path in sorted(glob.glob(os.path.join(base, "*"))):
        try:
            with open(os.path.join(path, "type")) as fh:
                if fh.read().strip() == "Battery":
                    return path
        except OSError:
            continue
    return None


def read_int(path, name):
    """Read an integer sysfs attribute, or None if absent/unreadable."""
    try:
        with open(os.path.join(path, name)) as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return None


def read_str(path, name):
    try:
        with open(os.path.join(path, name)) as fh:
            return fh.read().strip()
    except OSError:
        return None


def boot_time():
    """Wall-clock time the kernel booted, from /proc/stat, or None."""
    try:
        with open("/proc/stat") as fh:
            for line in fh:
                if line.startswith("btime "):
                    return float(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return None


def interpolate_soc(ocv):
    """Map a per-cell open-circuit voltage to a 0-100 SoC via the curve."""
    if ocv >= OCV_CURVE[0][0]:
        return 100.0
    if ocv <= OCV_CURVE[-1][0]:
        return 0.0
    for (v_hi, s_hi), (v_lo, s_lo) in zip(OCV_CURVE, OCV_CURVE[1:]):
        if v_lo <= ocv <= v_hi:
            frac = (ocv - v_lo) / (v_hi - v_lo)
            return s_lo + frac * (s_hi - s_lo)
    return 0.0


def fmt_duration(seconds):
    # No '<' or '>' here: waybar renders tooltips as Pango markup and a stray
    # angle bracket blanks the whole tooltip.
    if seconds < 60:
        return "under 1m"
    m = int(seconds // 60)
    h, m = divmod(m, 60)
    if h >= 48:
        return "over 48h"
    return f"{h}h {m:02d}m" if h else f"{m}m"


def markup_escape(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


# --- persisted state ---------------------------------------------------------

def state_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    return os.path.join(runtime, "uconsole-battery.state")


def load_state():
    """Load the JSON state dict; tolerate the old bare-float format and junk."""
    state = {}
    try:
        with open(state_path()) as fh:
            raw = fh.read().strip()
    except OSError:
        return state
    try:
        data = json.loads(raw)
    except ValueError:
        return state
    if isinstance(data, dict):
        state = data
    elif is_num(data):
        state = {"ema": float(data)}  # legacy format: bare EMA value
    return state


def write_json(path, data):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(data, fh)
        os.replace(tmp, path)
    except OSError:
        pass


def save_state(state):
    write_json(state_path(), state)


def state_home():
    return os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")


def learned_path():
    return os.path.join(state_home(), "uconsole-battery", "capacity.json")


def calibration_path():
    return os.path.join(state_home(), "uconsole-battery", "calibration.json")


def load_calibration():
    """Return the persisted curve-offset / resistance record (always a dict)."""
    try:
        with open(calibration_path()) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    if not isinstance(data.get("curve"), dict):
        data["curve"] = {}
    if not isinstance(data.get("r"), dict):
        data["r"] = {}
    return data


def learned_r(cal):
    """(ohms, samples) of the learned resistance, or (None, n) if untrusted."""
    r = cal.get("r", {})
    n = r.get("n", 0)
    ohms = r.get("ohms")
    if LEARN_RESISTANCE and is_num(ohms) and is_num(n) and n >= R_LEARN_MIN_SAMPLES:
        return ohms, n
    return None, n if is_num(n) else 0


def trusted_bins(cal):
    """Sorted [(bin centre, offset)] for bins with enough samples."""
    out = []
    for key, b in cal.get("curve", {}).items():
        try:
            lo = int(key)
        except ValueError:
            continue
        if isinstance(b, dict) and is_num(b.get("n")) and is_num(b.get("offset")) \
                and b["n"] >= CAL_MIN_SAMPLES:
            out.append((lo + CAL_BIN / 2.0, float(b["offset"])))
    return sorted(out)


def curve_offset(cal, est_raw):
    """Offset (points) to add to the raw voltage estimate at this level."""
    if not LEARN_CURVE:
        return 0.0
    bins = trusted_bins(cal)
    if not bins:
        return 0.0
    if est_raw <= bins[0][0]:
        d = bins[0][0] - est_raw
        off = bins[0][1] * max(0.0, 1.0 - d / CAL_TAPER_PCT)
    elif est_raw >= bins[-1][0]:
        d = est_raw - bins[-1][0]
        off = bins[-1][1] * max(0.0, 1.0 - d / CAL_TAPER_PCT)
    else:
        off = bins[-1][1]
        for (c0, o0), (c1, o1) in zip(bins, bins[1:]):
            if c0 <= est_raw <= c1:
                f = (est_raw - c0) / (c1 - c0) if c1 > c0 else 0.0
                off = o0 + f * (o1 - o0)
                break
    return max(-CAL_MAX_OFFSET_PCT, min(CAL_MAX_OFFSET_PCT, off))


def load_learned():
    """Return the persisted learned-capacity record, or None."""
    try:
        with open(learned_path()) as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    if isinstance(data, dict) and is_num(data.get("capacity_mah")) and data["capacity_mah"] > 0:
        return data
    return None


def smooth(state, pct):
    """Blend the voltage estimate with the previous one via EMA."""
    prev = state.get("ema")
    if EMA_ALPHA >= 1.0 or not is_num(prev):
        blended = pct
    else:
        blended = EMA_ALPHA * pct + (1 - EMA_ALPHA) * prev
    state["ema"] = blended
    return blended


def integrate_step(state, current, now):
    """Interval since the previous run: (dt capped, gap_exceeded, mean |I|)."""
    prev_ts = state.get("ts")
    last_i = state.get("last_current")
    if not is_num(prev_ts):
        return 0.0, False, abs(current)
    gap = max(0.0, now - prev_ts)
    i_prev = abs(last_i) if is_num(last_i) else abs(current)
    return min(gap, MAX_SAMPLE_GAP_S), gap > MAX_SAMPLE_GAP_S, (abs(current) + i_prev) / 2.0


# --- stuck-gauge assessment --------------------------------------------------

def assess_gauge(state, raw, status, est_pct, now, pack_mah, flow_inc, gap_exceeded=False):
    """Decide whether the kernel gauge is stuck. Updates `state`; returns
    (stuck, reasons)."""
    reasons = []
    prev_raw = state.get("raw")
    if gap_exceeded:
        # Flow during the gap was not seen, so the sit that spans it is not a
        # clean mAh-per-point sample.
        state["flow_gap"] = True
    # Yardstick for recovery: the coulomb-counted fallback when we have one
    # (it is the more accurate figure), else the voltage estimate.
    cc = state.get("cc_pct")
    ref_pct = cc if (state.get("anchor_valid") and is_num(cc)) else est_pct
    flow = state.get("flow_mah")
    flow = (float(flow) if is_num(flow) else 0.0) + flow_inc
    stuck = bool(state.get("stuck", False))

    changed = raw is not None and prev_raw is not None and raw != prev_raw

    if raw is None:
        stuck = True
        reasons.append("kernel capacity unreadable")
    else:
        if changed:
            # Flow that accumulated while the gauge sat at prev_raw, and how
            # far it then moved: the gauge's own mAh-per-point scale.
            state["last_move_flow_mah"] = flow
            state["last_move_pts"] = raw - prev_raw
            state["last_move_gap"] = bool(state.get("flow_gap"))
        if changed or prev_raw is None:
            flow = 0.0
            state["raw_changed_ts"] = now
            state["flow_gap"] = False

        # Recovery: the gauge moved, in a sensible direction, to a value that
        # agrees with the estimate.
        if stuck and changed:
            direction_ok = (
                (status == "Discharging" and raw < prev_raw)
                or (status == "Charging" and raw > prev_raw)
                or status not in ("Discharging", "Charging")
            )
            if direction_ok and abs(raw - ref_pct) <= RECOVER_AGREE_PCT:
                stuck = False
                reasons.append(f"recovered: moved {prev_raw}->{raw}, ref {ref_pct:.0f}")

        # The charger reporting Full while the gauge reads full corroborates it.
        if stuck and status == "Full" and raw >= 99:
            stuck = False
            reasons.append("charger reports Full with gauge at full")

        if raw == 100 and status == "Discharging" and est_pct < STUCK_FULL_MAX_EST_PCT:
            stuck = True
            reasons.append(f"reads 100 while discharging, est {est_pct:.0f}")
        if abs(raw - est_pct) > STUCK_DISAGREE_PCT:
            stuck = True
            reasons.append(f"disagrees with est by {abs(raw - est_pct):.0f} pts")
        limit = STUCK_NO_MOVE_PCT / 100.0 * pack_mah
        if (not changed and prev_raw is not None
                and status in ("Discharging", "Charging") and flow >= limit):
            stuck = True
            reasons.append(f"unchanged at {raw} after {flow:.0f} mAh flowed (limit {limit:.0f})")

    state.update({"raw": raw, "flow_mah": flow, "stuck": stuck, "moved": changed})
    return stuck, reasons


# --- session tracking: time on battery, runtime average, capacity learning ----

def status_kind(status):
    if status == "Discharging":
        return "discharging"
    if status == "Charging":
        return "charging"
    return "other"


def track_session(state, status, raw, stuck, dt, gap_exceeded, i_avg, flow_inc, now, voltage):
    """Update status timing, the runtime current average and the capacity-
    learning session. Returns a list of debug notes."""
    notes = []
    kind = status_kind(status)
    prev_kind = state.get("status_kind")
    gauge_ok = raw is not None and not stuck

    if kind != prev_kind:
        since = now
        since_boot = False
        if prev_kind is None:
            # Fresh state (boot, or first run of this version): the status has
            # plausibly held since the kernel came up.
            bt = boot_time()
            if bt is not None and bt < now:
                since, since_boot = bt, True
        state.update({
            "status_kind": kind,
            "status_since_ts": since,
            "status_since_boot": since_boot,
            "i_ema": None,
            "ema_span_s": 0.0,
            "sess_valid": kind == "discharging" and gauge_ok,
            "sess_start_pct": raw if (kind == "discharging" and gauge_ok) else None,
            "sess_flow_mah": 0.0,
            "mah_per_pt": None,
            "rate_moves": 0,
            "flow_gap": True,  # the flow behind the next move straddles statuses
        })
        notes.append(f"status now {kind}" + (" (since boot)" if since_boot else ""))
        return notes

    if dt > 0 and not gap_exceeded:
        k = 1.0 - math.exp(-dt / max(RUNTIME_TAU_S, 1.0))
        i_ema = state.get("i_ema")
        state["i_ema"] = i_avg if not is_num(i_ema) else i_ema + k * (i_avg - i_ema)
        span = state.get("ema_span_s")
        state["ema_span_s"] = (span if is_num(span) else 0.0) + dt
        if kind == "discharging" and state["ema_span_s"] >= RUNTIME_MIN_SPAN_S:
            # What the system draws from the pack: the only handle we have on
            # charger output later, since the AXP223 has no ACIN ADC.
            state["sys_w"] = state["i_ema"] * voltage
        if state.get("sess_valid"):
            sf = state.get("sess_flow_mah")
            state["sess_flow_mah"] = (sf if is_num(sf) else 0.0) + flow_inc
    if gap_exceeded:
        state["i_ema"] = None
        state["ema_span_s"] = 0.0
        notes.append("sample gap exceeded; runtime average reset")

    # Gauge scale from this move: mAh that flowed while it sat, per point moved.
    if (state.get("moved") and gauge_ok and not state.get("last_move_gap")
            and kind in ("discharging", "charging")):
        pts = state.get("last_move_pts")
        mah = state.get("last_move_flow_mah")
        expected_sign = -1 if kind == "discharging" else 1
        if is_num(pts) and is_num(mah) and pts * expected_sign > 0 and mah > 0:
            inst = mah / abs(pts)
            prev = state.get("mah_per_pt")
            moves = state.get("rate_moves") if is_num(state.get("rate_moves")) else 0
            state["mah_per_pt"] = inst if not is_num(prev) else prev + RATE_ALPHA * (inst - prev)
            state["rate_moves"] = moves + 1
            notes.append(f"gauge moved {pts:+d} on {mah:.0f} mAh -> {state['mah_per_pt']:.1f} mAh/pt")
    if not gauge_ok:
        state["mah_per_pt"] = None
        state["rate_moves"] = 0
    if state.get("sess_valid") and (gap_exceeded or not gauge_ok):
        state["sess_valid"] = False
        notes.append("capacity-learning session invalidated")
    return notes


def track_anchor(state, raw, stuck, status, est, i_signed, dt, gap_exceeded, pack_mah):
    """Maintain the coulomb-counted fallback percentage. Returns notes."""
    notes = []
    if not stuck and raw is not None:
        state.update({"cc_pct": float(raw), "anchor_valid": True,
                      "anchor_src": "gauge", "anchor_pct": raw})
        return notes
    cc = state.get("cc_pct")
    valid = bool(state.get("anchor_valid")) and is_num(cc)
    if valid and gap_exceeded:
        valid = False
        notes.append("coulomb anchor lost across sample gap")
    if valid and dt > 0:
        # i_signed < 0 while discharging, so the count falls.
        cc += i_signed * dt / 3600.0 * 1000.0 / pack_mah * 100.0
        cc = max(0.0, min(100.0, cc))
    if valid and abs(cc - est) > CC_REANCHOR_PCT:
        notes.append(f"coulomb count {cc:.0f} drifted from est {est:.0f}; re-anchored")
        valid = False
    if not valid:
        cc = est
        state.update({"anchor_src": "voltage", "anchor_pct": round(est, 1)})
        if not state.get("anchor_valid"):
            notes.append("anchored coulomb count on voltage estimate")
    if status == "Full":
        cc = 100.0
    state.update({"cc_pct": cc, "anchor_valid": True})
    return notes


def learn_calibration(cal, state, kind, raw, stuck, est_raw, voltage, current, dt,
                      gap_exceeded, now):
    """Feed one sample into the curve-offset and resistance learners.
    Returns (changed, notes)."""
    notes = []
    changed = False
    gauge_ok = raw is not None and not stuck
    if kind != "discharging":
        return changed, notes

    if LEARN_CURVE and gauge_ok and 5 < raw < 100 and est_raw < 97:
        key = str(int(est_raw) // CAL_BIN * CAL_BIN)
        b = cal["curve"].get(key)
        if not isinstance(b, dict) or not is_num(b.get("n")) or not is_num(b.get("offset")):
            b = {"n": 0, "offset": 0.0, "sessions": 0, "last_session": None}
        sample = raw - est_raw
        k = max(1.0 / (b["n"] + 1), 1.0 / CAL_EMA_N)
        b["offset"] = round(b["offset"] + k * (sample - b["offset"]), 3)
        b["n"] = b["n"] + 1
        sess = state.get("status_since_ts")
        if b.get("last_session") != sess:
            b["sessions"] = (b.get("sessions") or 0) + 1
            b["last_session"] = sess
        cal["curve"][key] = b
        changed = True

    if LEARN_RESISTANCE and dt > 0 and dt <= R_LEARN_MAX_DT_S and not gap_exceeded:
        lv, li = state.get("last_voltage"), state.get("last_current")
        if is_num(lv) and is_num(li) and li < 0 and current < 0:
            d_i = abs(current) - abs(li)
            if abs(d_i) >= R_LEARN_MIN_DI:
                r = -(voltage - lv) / d_i
                if R_LEARN_MIN_OHMS <= r <= R_LEARN_MAX_OHMS:
                    rr = cal["r"]
                    n = rr.get("n", 0) if is_num(rr.get("n")) else 0
                    ohms = rr.get("ohms") if is_num(rr.get("ohms")) else r
                    k = max(1.0 / (n + 1), 1.0 / R_EMA_N)
                    cal["r"] = {"ohms": round(ohms + k * (r - ohms), 5), "n": n + 1,
                                "last_sample": round(r, 4), "updated_ts": now}
                    changed = True
                    notes.append(f"R sample {r:.3f} ohm (dI {d_i:+.2f} A) -> {cal['r']['ohms']:.4f}")
                else:
                    notes.append(f"R sample {r:.3f} ohm rejected")
    if changed:
        cal["updated_ts"] = now
    return changed, notes


def update_learned(state, raw, learned, pack_ref, now):
    """Write a learned capacity when the current session has seen enough drop.
    Returns the (possibly new) learned record."""
    if not LEARN_CAPACITY or not state.get("sess_valid") or raw is None:
        return learned
    start = state.get("sess_start_pct")
    flow = state.get("sess_flow_mah")
    if not is_num(start) or not is_num(flow) or flow <= 0:
        return learned
    drop = start - raw
    if drop < LEARN_MIN_DROP_PCT:
        return learned
    cap = flow / drop * 100.0
    if not (0.5 * pack_ref <= cap <= 1.5 * pack_ref):
        return learned
    rec = {
        "capacity_mah": round(cap, 1),
        "updated_ts": now,
        "drop_pct": drop,
        "flow_mah": round(flow, 1),
        "session_start_ts": state.get("status_since_ts"),
    }
    write_json(learned_path(), rec)
    return rec


# --- main estimate -----------------------------------------------------------

def estimate(force_voltage=False, debug=False):
    """Return a dict describing the current battery state, or None."""
    path = find_battery()
    if path is None:
        return None

    status = read_str(path, "status") or "Unknown"
    v_uv = read_int(path, "voltage_now")
    i_ua = read_int(path, "current_now")
    raw_capacity = read_int(path, "capacity")

    if v_uv is None:
        return None

    voltage = v_uv / 1e6
    current = (i_ua or 0) / 1e6  # amps; negative = discharging

    # Reference capacity: config, else device tree, else fallback.
    pack_ref = PACK_CAPACITY_MAH
    pack_source = "configured"
    if pack_ref is None:
        cfd = read_int(path, "charge_full_design")
        pack_ref = cfd / 1000.0 if cfd else PACK_CAPACITY_FALLBACK_MAH
        pack_source = "device tree" if cfd else "default"
    learned = load_learned() if LEARN_CAPACITY else None
    pack_mah = learned["capacity_mah"] if learned else pack_ref

    cal = load_calibration()
    r_learned, r_n = learned_r(cal)
    r_used = r_learned if r_learned is not None else R_INTERNAL_OHMS
    r_source = "learned" if r_learned is not None else "configured"

    # Reconstruct open-circuit voltage. Discharging (I<0) sags the terminal, so
    # add the drop back; charging (I>0) inflates it, so subtract.
    ir = current * r_used
    ir = max(-MAX_IR_CORRECTION_V, min(MAX_IR_CORRECTION_V, ir))
    ocv = voltage - ir

    state = load_state()
    debug_log(debug, f"state in:  {state}")
    now = time.time()
    est_raw = interpolate_soc(ocv)
    offset = curve_offset(cal, est_raw)
    est = smooth(state, max(0.0, min(100.0, est_raw + offset)))
    dt, gap_exceeded, i_avg = integrate_step(state, current, now)
    last_i = state.get("last_current")
    i_signed = (current + (last_i if is_num(last_i) else current)) / 2.0
    flow_inc = i_avg * dt / 3600.0 * 1000.0
    stuck, reasons = assess_gauge(state, raw_capacity, status, est, now, pack_mah, flow_inc,
                                  gap_exceeded)
    notes = track_session(state, status, raw_capacity, stuck, dt, gap_exceeded, i_avg, flow_inc, now,
                          voltage)
    learned = update_learned(state, raw_capacity, learned, pack_ref, now)
    if learned:
        pack_mah, pack_source = learned["capacity_mah"], "learned"
    notes += track_anchor(state, raw_capacity, stuck, status, est, i_signed, dt, gap_exceeded, pack_mah)
    cal_changed, cal_notes = learn_calibration(cal, state, state.get("status_kind"), raw_capacity,
                                               stuck, est_raw, voltage, current, dt, gap_exceeded, now)
    notes += cal_notes
    if cal_changed:
        write_json(calibration_path(), cal)
    state.update({"ts": now, "last_current": current, "last_voltage": voltage})
    save_state(state)
    debug_log(debug, f"state out: {state}")
    debug_log(debug, f"pack {pack_mah:.0f} mAh ({pack_source}); R {r_used:.4f} ({r_source}, n={r_n}); "
                     f"raw {raw_capacity}; est {est:.1f} (raw {est_raw:.1f} offset {offset:+.1f}); "
                     f"cc {state.get('cc_pct'):.1f} ({state.get('anchor_src')}); "
                     f"stuck={stuck} {'; '.join(reasons + notes)}")

    use_voltage = force_voltage or FORCE_VOLTAGE
    cc_pct = state.get("cc_pct")
    # A full pack sitting on the charger reads ~100 regardless of curve noise.
    if status == "Full":
        pct = 100.0
        source = "gauge" if not stuck else "coulomb"
    elif use_voltage:
        pct = est
        source = "voltage"
    elif stuck:
        pct = cc_pct if is_num(cc_pct) else est
        source = "coulomb" if state.get("anchor_src") == "gauge" else "coulomb-voltage"
    else:
        pct = float(raw_capacity)
        source = "gauge"

    pct_int = int(round(max(0.0, min(100.0, pct))))
    est_int = int(round(max(0.0, min(100.0, est))))
    power = abs(voltage * current)

    # Time in the current status and the smoothed-rate time estimate.
    kind = state.get("status_kind")
    since = state.get("status_since_ts")
    status_for = (now - since) if is_num(since) else None
    i_ema = state.get("i_ema")
    span = state.get("ema_span_s")
    remaining_s = None
    remaining_kind = None
    remaining_basis = None
    mah_per_pt = state.get("mah_per_pt")
    if is_num(mah_per_pt) and not stuck:
        per_pt, remaining_basis = mah_per_pt, "gauge rate"
    else:
        per_pt, remaining_basis = pack_mah / 100.0, "capacity"
    if is_num(i_ema) and i_ema > 0.02 and is_num(span) and span >= RUNTIME_MIN_SPAN_S:
        if kind == "discharging":
            remaining_s = pct * per_pt / 1000.0 / i_ema * 3600.0
            remaining_kind = "remaining"
        elif kind == "charging" and pct < TIME_TO_FULL_MAX_PCT:
            remaining_s = (100.0 - pct) * per_pt / 1000.0 / i_ema * 3600.0
            remaining_kind = "to_full"

    return {
        "status": status,
        "kind": kind,
        "voltage": voltage,
        "current": current,
        "ocv": ocv,
        "power": power,
        "percent": pct_int,
        "estimate": est_int,
        "raw_capacity": raw_capacity,
        "stuck": stuck,
        "forced": bool(force_voltage or FORCE_VOLTAGE),
        "source": source,
        "anchor_pct": state.get("anchor_pct"),
        "offset": offset,
        "r_used": r_used,
        "r_source": r_source,
        "r_n": r_n,
        "cal_bins": len(trusted_bins(cal)),
        "cal_samples": sum(b.get("n", 0) for b in cal.get("curve", {}).values()
                           if isinstance(b, dict) and is_num(b.get("n"))),
        "status_for_s": status_for,
        "status_since_boot": bool(state.get("status_since_boot")),
        "avg_current": i_ema if is_num(i_ema) else None,
        "remaining_s": remaining_s,
        "remaining_kind": remaining_kind,
        "remaining_basis": remaining_basis,
        "sys_w": state.get("sys_w") if is_num(state.get("sys_w")) else None,
        "mah_per_pt": mah_per_pt if is_num(mah_per_pt) else None,
        "rate_moves": state.get("rate_moves") if is_num(state.get("rate_moves")) else 0,
        "pack_mah": pack_mah,
        "pack_source": pack_source,
        "learned": learned,
        "sess_valid": bool(state.get("sess_valid")),
        "sess_start_pct": state.get("sess_start_pct"),
    }


# --- CPU governor (uConsole-sleep) --------------------------------------------
#
# sleep-cpu-governor (uConsole-sleep >= 1.8) publishes its decision in
# /run/uconsole-sleep/cpu-governor.state and takes a profile request for the
# current boot through /run/uconsole-sleep/cpu-profile. All of this is
# optional: without that package the widget is the plain battery widget.

MENU_PROFILES = ("auto", "performance", "schedutil", "powersave")
CPU_SET_WAIT_S = 3.0
MSG_NEEDS_PACKAGE = "CPU profile control needs the uconsole-sleep package (>= 1.8)"
MSG_NOT_RUNNING = "sleep-cpu-governor is not running or older than 1.8"


def sleep_run_dir():
    return os.environ.get("UCONSOLE_SLEEP_RUN") or "/run/uconsole-sleep"


def sleep_bin():
    return os.environ.get("UCONSOLE_SLEEP_BIN") or "/usr/local/bin/sleep_cpu_governor"


def cpufreq_dir():
    return os.environ.get("UCONSOLE_CPUFREQ") or "/sys/devices/system/cpu/cpufreq/policy0"


def menu_file():
    return (os.environ.get("UCONSOLE_BATTERY_MENU_FILE")
            or "/usr/share/uconsole-tweaks/waybar-cpu-profile-menu.ui")


def read_text(path):
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except OSError:
        return ""


def read_cpu_state():
    """The daemon's state as a dict, or None when it is not there."""
    try:
        with open(os.path.join(sleep_run_dir(), "cpu-governor.state"), "r") as f:
            state = json.load(f)
    except (OSError, ValueError):
        return None
    return state if isinstance(state, dict) else None


def cpu_tier():
    """('full', state) with a running daemon >= 1.8 (it removes the state file
    when it stops), ('degraded', None) when uConsole-sleep is installed but
    there is no state, ('stock', None) when it is not installed."""
    state = read_cpu_state()
    if state is not None:
        return "full", state
    if os.path.exists(sleep_bin()):
        return "degraded", None
    return "stock", None


def cpu_text(tier, state):
    """Governor and the daemon's own reason for it, or None in stock mode.
    Rendered from the state fields; the governor name alone says nothing
    about why it is set."""
    if tier == "stock":
        return None
    if tier == "degraded":
        gov = read_text(os.path.join(cpufreq_dir(), "scaling_governor")) or "unknown"
        return f"{gov} — governor service not running or older than 1.8"
    gov = str(state.get("governor") or "unknown")
    if state.get("mode") == "manual":
        return f"{gov} — set manually (until reboot)"
    reason = state.get("reason")
    if reason == "low-battery" and is_num(state.get("enter_pct")):
        return f"{gov} — automatic (battery below {state['enter_pct']:g}%)"
    if reason == "low-battery":
        return f"{gov} — automatic (low battery)"
    if reason == "hold" and is_num(state.get("exit_pct")):
        return f"{gov} — automatic (holding until {state['exit_pct']:g}%)"
    if reason == "ac":
        return f"{gov} — automatic (on AC)"
    return f"{gov} — automatic"


def cpu_available(state):
    words = read_text(os.path.join(cpufreq_dir(), "scaling_available_governors")).split()
    if not words and state and isinstance(state.get("available"), list):
        words = [str(w) for w in state["available"]]
    return words


def notify(msg):
    """Desktop notification, best effort: a waybar menu item has no terminal."""
    exe = shutil.which("notify-send")
    if not exe:
        return
    try:
        subprocess.Popen([exe, "-a", "uconsole-battery", "CPU profile", msg],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except OSError:
        pass


def cpu_fail(msg, code=1):
    print(msg, file=sys.stderr)
    notify(msg)
    return code


def waybar_signal():
    """The real-time signal number for WAYBAR_SIGNAL, or None when disabled.
    Waybar does not handle SIGRTMIN+0, hence the lower bound."""
    n = WAYBAR_SIGNAL
    if not is_num(n) or not 1 <= n <= signal.SIGRTMAX - signal.SIGRTMIN:
        return None
    return signal.SIGRTMIN + int(n)


def refresh_waybar():
    """Make this user's waybar re-run the module now. Returns how many were
    signalled. An unhandled real-time signal would kill the process, so only
    a `waybar` that has a handler installed for it gets one."""
    signum = waybar_signal()
    if signum is None:
        return 0
    sent = 0
    for stat_dir in glob.glob("/proc/[0-9]*"):
        try:
            if os.stat(stat_dir).st_uid != os.getuid():
                continue
            if read_text(os.path.join(stat_dir, "comm")) != "waybar":
                continue
            caught = 0
            with open(os.path.join(stat_dir, "status"), "r") as f:
                for line in f:
                    if line.startswith("SigCgt:"):
                        caught = int(line.split()[1], 16)
                        break
            if not caught >> (signum - 1) & 1:
                continue
            os.kill(int(os.path.basename(stat_dir)), signum)
            sent += 1
        except (OSError, ValueError):
            continue
    return sent


def profile_applied(state, word):
    return (state is not None and state.get("requested") == word
            and (word == "auto" or state.get("governor") == word))


def set_cpu_profile(word):
    """Ask the daemon for `word` ('auto' or a governor) for this boot."""
    tier, state = cpu_tier()
    if tier == "stock":
        return cpu_fail(MSG_NEEDS_PACKAGE)
    if tier == "degraded":
        return cpu_fail(MSG_NOT_RUNNING)
    available = cpu_available(state)
    if word != "auto" and word not in available:
        return cpu_fail(f"unknown CPU profile '{word}'; choose auto or one of: "
                        f"{' '.join(available)}", 2)
    if profile_applied(state, word):
        # Already in force; the daemon would not rewrite its state for this.
        print(cpu_text("full", state))
        refresh_waybar()
        return 0

    path = os.path.join(sleep_run_dir(), "cpu-profile")
    started = time.time()
    try:
        # No O_CREAT: only the daemon creates the file, with its permissions.
        fd = os.open(path, os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW)
    except FileNotFoundError:
        return cpu_fail(MSG_NOT_RUNNING)
    except PermissionError:
        return cpu_fail(f"no permission to write {path} (see CPU_PROFILE_GROUP in "
                        "/etc/uconsole-sleep/config)")
    except OSError as exc:
        return cpu_fail(f"cannot write {path}: {exc}")
    try:
        os.write(fd, (word + "\n").encode())
    finally:
        os.close(fd)

    deadline = time.monotonic() + CPU_SET_WAIT_S
    while time.monotonic() < deadline:
        state = read_cpu_state()
        if (profile_applied(state, word) and is_num(state.get("ts"))
                and state["ts"] >= started):
            print(cpu_text("full", state))
            refresh_waybar()
            return 0
        time.sleep(0.1)
    return cpu_fail(f"'{word}' was saved but not applied within {CPU_SET_WAIT_S:g} s; "
                    "is sleep-cpu-governor running?")


def menu_snippet(trailing_comma=False):
    exe = "/usr/local/bin/uconsole-battery"
    width = max(len(p) for p in MENU_PROFILES) + 3
    actions = ",\n".join(
        f'    {(chr(34) + p + chr(34) + ":"):<{width}} "{exe} --set-cpu-profile {p}"'
        for p in MENU_PROFILES)
    # "signal" lets --set-cpu-profile refresh the module the moment a profile
    # is applied (see refresh_waybar).
    refresh = (f'"signal": {int(WAYBAR_SIGNAL)},\n'
               if waybar_signal() is not None else "")
    return (refresh +
            '"menu": "on-click",\n'
            f'"menu-file": "{menu_file()}",\n'
            '"menu-actions": {\n'
            f"{actions}\n"
            "}" + ("," if trailing_comma else ""))


def waybar_menu_snippet(if_available):
    tier, _ = cpu_tier()
    have_menu = os.path.isfile(menu_file())
    if if_available:
        # For config generators: the keys, comma-terminated so they can go
        # anywhere in a module block, only when the menu would do something.
        if tier == "stock" or not have_menu:
            return 1
        print(menu_snippet(trailing_comma=True))
        return 0
    print(menu_snippet())
    note = {
        "full": "uconsole-sleep >= 1.8 detected: the menu will work.",
        "degraded": "uconsole-sleep is installed, but " + MSG_NOT_RUNNING
                    + ": until it is, the menu items only raise a notification.",
        "stock": "uconsole-sleep not detected: the menu items will only raise a "
                 "notification until it (>= 1.8) is installed.",
    }[tier]
    print(f"# {note}", file=sys.stderr)
    if not have_menu:
        print(f"# {menu_file()} is missing (shipped by uconsole-tweaks >= 0.6.0).",
              file=sys.stderr)
    return 0


def css_class(st):
    if st["status"] == "Charging":
        return "charging"
    if st["status"] == "Full":
        return "full"
    if st["percent"] <= CRITICAL_PCT:
        return "critical"
    if st["percent"] <= WARNING_PCT:
        return "warning"
    return "discharging"


def remaining_text(st):
    """Short remaining-time string for bar text / --text, or ''."""
    if st["remaining_s"] is None:
        return ""
    t = fmt_duration(st["remaining_s"])
    return f"~{t}" if st["remaining_kind"] == "remaining" else f"full in ~{t}"


def bar_text(st):
    fields = {
        "pct": st["percent"],
        "volt": st["voltage"],
        "amps": st["current"],
        "watts": st["power"],
        "remaining": remaining_text(st),
        "status": st["status"].lower(),
    }
    try:
        return TEXT_FORMAT.format(**fields).strip()
    except (KeyError, ValueError, IndexError):
        return f"{st['percent']}%"


def tooltip(st):
    lines = [
        f"Battery {st['percent']}% ({st['status'].lower()})",
        f"Voltage: {st['voltage']:.3f} V  (OCV est {st['ocv']:.3f} V)",
        f"Current: {st['current']:+.3f} A",
        f"Power:   {st['power']:.2f} W",
    ]
    raw = st["raw_capacity"]
    raw_txt = f"{raw}%" if raw is not None else "unreadable"
    if st["source"] == "gauge":
        lines.append(f"Source: AXP223 gauge (voltage estimate {st['estimate']}%)")
    elif st["source"] == "voltage" and not st["stuck"]:
        lines.append(f"Source: voltage estimate (forced; AXP223 gauge {raw_txt})")
    elif st["source"] == "voltage":
        lines.append(f"Source: voltage estimate — AXP223 gauge stuck at {raw_txt}")
    elif st["source"] == "coulomb":
        lines.append(f"Source: charge count from last good gauge {st['anchor_pct']}% "
                     f"(voltage est {st['estimate']}%) — AXP223 stuck at {raw_txt}")
    else:
        lines.append(f"Source: charge count from voltage est {st['anchor_pct']}% "
                     f"(now {st['estimate']}%) — AXP223 stuck at {raw_txt}")

    if st["status_for_s"] is not None:
        label = {"discharging": "On battery", "charging": "Charging for"}.get(st["kind"], "On charger")
        boot = " (since boot)" if st["status_since_boot"] else ""
        lines.append(f"{label}: {fmt_duration(st['status_for_s'])}{boot}")
    if st["kind"] in ("discharging", "charging"):
        if st["remaining_s"] is not None:
            avg_w = st["avg_current"] * st["voltage"]
            if st["remaining_basis"] == "gauge rate":
                basis = f"gauge rate {st['mah_per_pt']:.0f} mAh/pt over {st['rate_moves']} moves"
            else:
                basis = "from pack capacity"
            label = "Remaining" if st["remaining_kind"] == "remaining" else "Full in"
            lines.append(f"{label}: ~{fmt_duration(st['remaining_s'])} at {avg_w:.1f} W avg ({basis})")
        elif st["kind"] == "charging" and st["percent"] >= TIME_TO_FULL_MAX_PCT:
            lines.append("Full in: topping off")
        else:
            lines.append("Remaining: estimating…")
    if st["kind"] == "charging":
        # No ACIN ADC on the AXP223: charger output = what goes into the pack
        # (measured) + what the system takes (last seen on battery).
        if st["sys_w"] is not None:
            lines.append(f"Charger: ~{st['power'] + st['sys_w']:.1f} W est. "
                         f"({st['power']:.1f} W into pack + ~{st['sys_w']:.1f} W system, from last discharge)")
        else:
            lines.append(f"Charger: {st['power']:.1f} W into pack + system draw (not yet measured)")

    pack = f"Pack: {st['pack_mah']:.0f} mAh ({st['pack_source']}"
    if st["pack_source"] == "learned" and st["learned"]:
        day = time.strftime("%Y-%m-%d", time.localtime(st["learned"].get("updated_ts", 0)))
        pack += f" {day} from {st['learned'].get('drop_pct', 0):.0f}% drop"
    pack += ")"
    if st["kind"] == "discharging" and st["sess_valid"] and is_num(st["sess_start_pct"]):
        pack += f"; learning since {st['sess_start_pct']}%"
    lines.append(pack)
    cal = f"Calibration: curve offset {st['offset']:+.1f} here"
    cal += f" ({st['cal_bins']} bins, {st['cal_samples']} samples)" if st["cal_samples"] else " (none yet)"
    cal += f"; R {st['r_used'] * 1000:.0f} mΩ ({st['r_source']}"
    cal += f", {st['r_n']} steps)" if st["r_source"] == "learned" else (f", {st['r_n']} steps so far)" if st["r_n"] else ")")
    lines.append(cal)
    if st.get("cpu"):
        lines.append(f"CPU: {st['cpu']}")
    return markup_escape("\n".join(lines))


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--percent", action="store_true", help="print integer percent only")
    g.add_argument("--text", action="store_true", help="print '<pct>% (<state>[, ~<time> left])'")
    ap.add_argument("--force-voltage", action="store_true",
                    help="always display the voltage estimate, ignoring the kernel gauge")
    ap.add_argument("--calibration", action="store_true",
                    help="print the learned capacity, curve offsets and resistance as JSON")
    ap.add_argument("--debug", action="store_true",
                    help="log config, state and the stuck decision to stderr")
    ap.add_argument("--cpu-profile", action="store_true",
                    help="print the CPU governor and why it is set (needs uconsole-sleep >= 1.8)")
    ap.add_argument("--set-cpu-profile", metavar="PROFILE",
                    help="select 'auto' or a governor name for this boot")
    ap.add_argument("--waybar-menu-snippet", action="store_true",
                    help="print the waybar keys that add the CPU profile menu")
    ap.add_argument("--if-available", action="store_true",
                    help="with --waybar-menu-snippet: print the keys (comma-terminated) "
                         "and exit 0 only if uconsole-sleep and the menu file are "
                         "installed; otherwise print nothing and exit 1")
    args = ap.parse_args()

    load_config(debug=args.debug)
    # The CPU profile commands never touch the battery or its state files.
    if args.set_cpu_profile is not None:
        return set_cpu_profile(args.set_cpu_profile)
    if args.waybar_menu_snippet:
        return waybar_menu_snippet(args.if_available)
    cpu_mode, cpu_state = cpu_tier()
    if args.cpu_profile:
        if cpu_mode != "full":
            print(MSG_NEEDS_PACKAGE if cpu_mode == "stock" else MSG_NOT_RUNNING,
                  file=sys.stderr)
            return 1
        print(cpu_text(cpu_mode, cpu_state))
        return 0

    if args.calibration:
        cal = load_calibration()
        print(json.dumps({
            "capacity": load_learned(),
            "curve": cal.get("curve"),
            "trusted_bins": trusted_bins(cal),
            "r": cal.get("r"),
            "files": [learned_path(), calibration_path()],
        }, indent=2))
        return 0
    st = estimate(force_voltage=args.force_voltage, debug=args.debug)
    if st is None:
        if args.percent:
            print("0")
        elif args.text:
            print("no battery")
        else:
            print(json.dumps({"text": "?", "tooltip": "battery not found", "class": "critical"}))
        return 1

    if args.percent:
        print(st["percent"])
    elif args.text:
        rem = remaining_text(st)
        extra = f", {rem} left" if st["remaining_kind"] == "remaining" else (f", {rem}" if rem else "")
        print(f"{st['percent']}% ({st['status'].lower()}{extra})")
    else:
        cls = css_class(st)
        st["cpu"] = cpu_text(cpu_mode, cpu_state)
        extra = []
        if st["stuck"]:
            extra.append("gauge-stuck")
        if cpu_state is not None and cpu_state.get("mode") == "manual":
            extra.append("cpu-manual")
        classes = [cls] + extra if extra else cls
        print(json.dumps({
            "text": bar_text(st),
            "alt": cls,  # waybar selects format-icons by `alt`; `class` drives CSS
            "percentage": st["percent"],
            "tooltip": tooltip(st),
            "class": classes,
        }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
