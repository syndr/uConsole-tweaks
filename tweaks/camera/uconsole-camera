#!/bin/sh
# Launch Picamera2's full-featured Qt camera app (app_full.py) for a CSI camera.
#
# The app's GL preview only initialises when Qt is given a single platform.
# With the "wayland;xcb" fallback list that many Wayland sessions export it
# dies at startup with EGL_BAD_ALLOC, so pin the platform to match the session.
#
# The app saves into the current directory as "<Name>.<type>" ("test" when the
# Name field is empty), so start it in the pictures folder.

APP=/usr/local/share/uconsole-tweaks/camera/app_full.py

if [ -n "$WAYLAND_DISPLAY" ]; then
    export QT_QPA_PLATFORM=wayland
else
    export QT_QPA_PLATFORM=xcb
fi

dir="$(xdg-user-dir PICTURES 2>/dev/null)"
dir="${dir:-$HOME/Pictures}/Camera"
mkdir -p "$dir" && cd "$dir" || exit 1

exec python3 "$APP" "$@"
